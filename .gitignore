# Local .terraform directories
**/.terraform/*
.terraform.lock.hcl
# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

**/keys/**
kubeconfig
config.yaml
hosts.old.yaml
hosts.ini
.kube
.env

# ansible.cfg sends every task result here, including the join token, the certificate key and
# the AutoGlue org secret. #433 (no_log + file modes) was closed as won't-do, so this file will
# keep containing credentials -- and this repo is public. Never commit it, never upload it as a
# CI artifact, never attach it to a support bundle.
/ansible/ansible.log

# operator inventory: contains private IPs, SSH users and key paths.
# ship ansible/inventory/hosts.yaml.example instead, or generate it with terraform.
/ansible/inventory/hosts.yaml

# NOTE: /ansible/molecule/*/inventory/hosts.yaml is deliberately NOT listed here, even though
# create.yml overwrites it with the live public IPs, SSH users and key paths of the test VMs.
# Molecule resolves inventory.links.hosts before running anything and aborts with
# "The source path ... does not exist" if the target is missing, so the empty placeholders have
# to stay tracked. After a molecule run those files are dirty and contain real infrastructure
# data -- `git checkout` them before committing, and never `git add -A` blind.

# inventories molecule generates at create time. anchored to the scenario inventory
# directories on purpose -- as bare filenames, "rotate-master-nodes.yaml" also matches
# the playbook and the task file of the same name.
/ansible/molecule/*/inventory/scale-down-worker.yaml
/ansible/molecule/*/inventory/scale-up-worker.yaml
/ansible/molecule/*/inventory/scale-down-ctrp.yaml
/ansible/molecule/*/inventory/scale-up-ctrp.yaml
/ansible/molecule/*/inventory/rotate-master-nodes.yaml
/ansible/molecule/*/inventory/second-rotate-master-nodes.yaml

# ids of the AutoGlue DNS domain and record that create.yml builds, handed to destroy.yml
/ansible/molecule/*/autoglue-ids.yaml
