apiVersion: projectcalico.org/v3
kind: GlobalNetworkPolicy
metadata:
  name: allow-port-web-on-lb-nodes
spec:
  preDNAT: true
  applyOnForward: true
  types:
    - Ingress
  ingress:
    - action: Allow
      protocol: TCP
      destination:
        ports:
          - 80
          - 443
    - action: Allow
      protocol: ICMP
    - action: Deny
 
---

apiVersion: projectcalico.org/v3
kind: GlobalNetworkPolicy
metadata:
  name: allow-all-egress-lb-nodes
spec:
  selector: all()
  types:
    - Egress
  egress:
    - action: Allow

---

# Felix's default inbound failsafes (tcp 22, 179, 2379, 2380, 5473, 6443, 6666, 6667, udp 68) are
# accepted on a HostEndpoint BEFORE any policy, so the Deny above never sees them and they are
# open on the load-balancer nodes' public interface. Nothing public needs them: ssh goes through
# the bastion on the private interface, which has no HostEndpoint. Only the DHCP client port
# stays, because the public interface gets its address by DHCP.
apiVersion: projectcalico.org/v3
kind: FelixConfiguration
metadata:
  name: default
spec:
  failsafeInboundHostPorts:
    - protocol: UDP
      port: 68