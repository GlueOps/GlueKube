
installation:
  registry: quay.repo.gpkg.io
  imagePath: calico
  enabled: true
  typhaMetricsPort: 9093
  cni:
    type: Calico
  calicoNetwork:
    bgp: Disabled
    ipPools:
    - cidr: {{ calico_network_calico_cidr }} # this should be in podSubnet range
      encapsulation: VXLAN
{% if calico_node_address_autodetection_v4 is defined and calico_node_address_autodetection_v4 | length > 0 %}
    nodeAddressAutodetectionV4:
        firstFound: false
        cidrs:
          - "{{ calico_node_address_autodetection_v4 }}"
{% endif %}

  # Prefer the platform node for calico-kube-controllers, but stay schedulable on any worker.
  # Scoped to this deployment rather than controlPlaneTolerations, which would also cover
  # typha. calico-apiserver, goldmane and whisker get the same placement through their own
  # resources at the bottom of this file.
  # The control-plane taint is deliberately NOT tolerated: none of these has to be on a master,
  # and with no platform node the preferred affinity matches nothing, so the scheduler would
  # otherwise pick one. Nothing in install-calico.yaml waits on them, so on a fresh cluster they
  # sit Pending only until the workers join; apply-calico-firewall.yaml, which does wait for
  # calico-apiserver, runs after that. A master whose control-plane taint is removed in the
  # inventory still qualifies.
  # calico-node is deliberately untouched -- it is a DaemonSet and must cover every node.
  calicoKubeControllersDeployment:
    spec:
      template:
        spec:
          # Affinity must be "preferred": taint-nodes.yaml runs after this role, so
          # glueops.dev/role exists on no node yet at install time. A hard nodeSelector
          # or requiredDuringScheduling would deadlock the bootstrap.
          affinity:
            nodeAffinity: &platform_node_affinity
              preferredDuringSchedulingIgnoredDuringExecution:
              - weight: 100
                preference:
                  matchExpressions:
                  - key: glueops.dev/role
                    operator: In
                    values:
                    - glueops-platform
          tolerations: &platform_tolerations
          - key: glueops.dev/role
            operator: Equal
            value: glueops-platform
            effect: NoSchedule

  # Keep typha off the load-balancer nodes: it is hostNetwork, so there it listens on the
  # public interface too. Tolerations are left to the operator (tolerate-all), which already
  # covers the platform taint and the not-ready taint nodes carry until the CNI is up.
  typhaDeployment:
    spec:
      template:
        spec:
          affinity:
            nodeAffinity:
              # "DoesNotExist" rather than a nodeSelector on glueops.dev/role: unlabelled nodes
              # satisfy it, so it cannot deadlock the bootstrap (see the note above).
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                    - key: use-as-loadbalancer
                      operator: DoesNotExist
              preferredDuringSchedulingIgnoredDuringExecution:
              - weight: 100
                preference:
                  matchExpressions:
                  - key: glueops.dev/role
                    operator: In
                    values:
                    - glueops-platform
            # setting affinity replaces the operator's own, so restate its typha spread
            podAntiAffinity:
              preferredDuringSchedulingIgnoredDuringExecution:
              - weight: 1
                podAffinityTerm:
                  labelSelector:
                    matchExpressions:
                    - key: k8s-app
                      operator: In
                      values:
                      - calico-typha
                  topologyKey: topology.kubernetes.io/zone

# Same placement as calico-kube-controllers above. Setting tolerations here replaces the
# operator's defaults, which are what tolerated the control-plane taint.
apiServer:
  enabled: true
  apiServerDeployment:
    spec:
      template:
        spec:
          affinity:
            nodeAffinity: *platform_node_affinity
            # setting affinity replaces the operator's own, so restate its apiserver spread
            podAntiAffinity:
              preferredDuringSchedulingIgnoredDuringExecution:
              - weight: 100
                podAffinityTerm:
                  labelSelector:
                    matchLabels:
                      k8s-app: calico-apiserver
                  namespaces:
                  - calico-system
                  topologyKey: kubernetes.io/hostname
              - weight: 100
                podAffinityTerm:
                  labelSelector:
                    matchLabels:
                      k8s-app: calico-apiserver
                  namespaces:
                  - calico-system
                  topologyKey: topology.kubernetes.io/zone
          tolerations: *platform_tolerations

goldmane:
  enabled: true
  goldmaneDeployment:
    spec:
      template:
        spec:
          affinity:
            nodeAffinity: *platform_node_affinity
          tolerations: *platform_tolerations

whisker:
  enabled: true
  whiskerDeployment:
    spec:
      template:
        spec:
          affinity:
            nodeAffinity: *platform_node_affinity
          tolerations: *platform_tolerations

# Resource requests and limits for the tigera/operator pod.
resources: {}

affinity:
  nodeAffinity:
    # "preferred" means: Try your best to put it here, but don't fail if you can't.
    preferredDuringSchedulingIgnoredDuringExecution:
    - weight: 100 # A higher weight (1-100) tells the scheduler to prioritize this rule
      preference:
        matchExpressions:
        - key: "glueops.dev/role"
          operator: In
          values:
          - "glueops-platform"

tolerations:
- effect: NoExecute
  operator: Exists
- effect: NoSchedule
  operator: Exists

nodeSelector:
  kubernetes.io/os: linux

# Custom annotations for the tigera/operator pod.
podAnnotations: {}

# Custom labels for the tigera/operator pod.
podLabels: {}

# Image and registry configuration for the tigera/operator pod.
tigeraOperator:
  image: tigera/operator
  version: "{{ calico_tigera_operator_version }}"
  registry: quay.repo.gpkg.io
calicoctl:
  image: dockerhub.repo.gpkg.io/calico/ctl
  tag: "{{ calico_chart_version }}"

defaultFelixConfiguration:
  enabled: false
  logSeverityScreen: Info