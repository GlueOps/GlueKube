# Preferred affinity, not a hard nodeSelector -- the same call calico.yaml.j2 makes in this repo,
# and for the same reason. roles/master/tasks/main.yaml installs the addons (line 23) before
# taint-nodes.yaml has run, so glueops.dev/role exists on NO node at install time; on the molecule
# scenarios it never exists at all, because common/hosts.yaml.j2 writes `extra.taints` and no
# `extra.labels`. A hard nodeSelector leaves the pod Pending while local-path is the cluster's
# default StorageClass -- every new PVC then waits forever with nothing to explain why.
# "preferred" still lands it on the platform nodepool on any cluster that has one.
affinity:
  nodeAffinity:
    preferredDuringSchedulingIgnoredDuringExecution:
      - weight: 100
        preference:
          matchExpressions:
            - key: glueops.dev/role
              operator: In
              values:
                - glueops-platform
# The platform nodepool carries a matching NoSchedule taint. The control-plane taint is deliberately
# NOT tolerated: with no glueops-platform node (molecule, or a cluster without that pool) the
# preferred affinity above matches nothing and the scheduler would otherwise pick a master. The
# helm install does not wait, so on a fresh cluster the pod sits Pending only until the workers join
# in the next play. A master with its control-plane taint removed in the inventory still qualifies.
tolerations:
  - effect: NoSchedule
    key: glueops.dev/role
    operator: Equal
    value: glueops-platform

defaultArgs:
  - --cert-dir=/tmp
  - --kubelet-preferred-address-types=InternalIP,ExternalIP,Hostname
  - --kubelet-use-node-status-port
  - --metric-resolution=15s
  - --kubelet-insecure-tls

image:
  repository: k8s.repo.gpkg.io/metrics-server/metrics-server