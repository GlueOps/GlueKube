apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    token: "{{ hostvars[orchestrator_node]['join_token'].stdout }}"
    apiServerEndpoint: "{{ loadbalancer_apiserver }}:6443"
    caCertHashes:
      - "sha256:{{ hostvars[orchestrator_node]['join_hash'].stdout }}"
nodeRegistration:
  kubeletExtraArgs:
    - name: "node-ip"
      value: "{{ hostvars[node_to_add | default(inventory_hostname)].ip }}"
controlPlane:
  localAPIEndpoint:
    advertiseAddress: "{{ hostvars[node_to_add | default(inventory_hostname)].ip }}"
    bindPort: 6443
  certificateKey: "{{ certificate_key }}"

# Without this the joining control-plane node has no way to override the cluster-wide kubelet
# configuration, which was sized from the facts of the node that ran `kubeadm init` (#449).
patches:
  directory: /etc/kubernetes/patches
