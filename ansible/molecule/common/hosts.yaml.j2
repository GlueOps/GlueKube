{#
  The inventory every scenario writes, in one template.

  scale-cluster alone wrote five near-identical copies of this by hand, differing only in which
  slice of the node list each group got; rotate-master-nodes wrote three. They are now all one
  template task with two vars:

    inv_masters   list of {name, vmid, role} for the masters this file should contain
    inv_workers   the same for the workers

  Both are slices of master_nodes_list / worker_nodes_list, which proxmox-provision.yml sets.

  ansible_host and ip are now the SAME address, and that is the point of the bastion. The nodes
  have no public leg any more -- net0 is the NAT bridge, which gets them to apt and
  registry.k8s.io and nothing back -- so the only address anything connects to them on is the LAN
  one, and the only host on that LAN with an ansible on it is the bastion this file is written to.
  `ip` keeps its old meaning: what every cluster component binds to (etcd_initial_cluster, the
  kubelet, the ctrp record).

  This file is rendered ONTO THE BASTION, not into the local scenario directory. Molecule's own
  inventory is bastion-hosts.yaml.j2 instead.
#}
all:
  children:
    masters:
      hosts:
{% for node in inv_masters %}
        {{ node.name }}:
          ansible_host: {{ node_lan_addresses[node.name] }}
          ip: {{ node_lan_addresses[node.name] }}
          ansible_user: cluster
          ansible_ssh_private_key_file: keys/vm_node
          extra:
            taints:
              - node-role.kubernetes.io/control-plane:NoSchedule-
{% endfor %}
{% if inv_masters | length == 0 %}
        {}
{% endif %}
    workers:
      hosts:
{% for node in inv_workers %}
        {{ node.name }}:
          ansible_host: {{ node_lan_addresses[node.name] }}
          ip: {{ node_lan_addresses[node.name] }}
          ansible_user: cluster
          ansible_ssh_private_key_file: keys/vm_node
          extra:
            taints: []
{% endfor %}
{% if inv_workers | length == 0 %}
        {}
{% endif %}
